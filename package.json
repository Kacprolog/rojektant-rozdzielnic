{
  "name": "projektant-rozdzielnic",
  "version": "0.21.0",
  "private": true,
  "description": "Interaktywny konfigurator rozdzielnic modułowych (DIN TH35) z widokiem okablowania, kontrolą projektu i zestawieniem materiałów.",
  "scripts": {
    "start": "node scripts/serve.js 4173",
    "test": "playwright test --reporter=list",
    "test:ui": "playwright test --ui",
    "druk": "node scripts/podglad-druku.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p . && tsc -p tsconfig.sw.json"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "prettier": "3.3.3",
    "typescript": "5.6.3"
  }
}
